{
    "name": "smithy/smithy-php",
    "description": "Smithy runtime and code generator for PHP",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "mtdowling/jmespath.php": "^2.9.1",
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "revolt/event-loop": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "ext-zlib": "Enables gzip request compression."
    },
    "autoload": {
        "psr-4": {
            "Smithy\\Async\\": "src/Async/",
            "Smithy\\Codegen\\": "src/Codegen/",
            "Smithy\\Core\\": "src/Core/",
            "Smithy\\Client\\": "src/Client/",
            "Smithy\\Protocol\\": "src/Protocol/",
            "Smithy\\Http\\": "src/Http/",
            "Smithy\\Codec\\": "src/Codec/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smithy\\ProtocolTests\\AwsJson1_0\\": "codegen-output/aws-json-1-0/src/",
            "Smithy\\ProtocolTests\\AwsJson1_1\\": "codegen-output/aws-json-1-1/src/",
            "Smithy\\ProtocolTests\\AwsQuery\\": "codegen-output/aws-query/src/",
            "Smithy\\ProtocolTests\\RpcV2Cbor\\": "codegen-output/rpcv2-cbor/src/",
            "Smithy\\ProtocolTests\\RpcV2Json\\": "codegen-output/rpcv2-json/src/",
            "Smithy\\ProtocolTests\\RestJson\\": "codegen-output/rest-json/src/",
            "Smithy\\ProtocolTests\\RestXml\\": "codegen-output/rest-xml/src/",
            "Smithy\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/smithy-php-codegen"
    ],
    "scripts": {
        "test": "phpunit",
        "static-analysis": "phpstan analyse --no-progress",
        "codegen": "php bin/smithy-php-codegen",
        "codegen-output": "php tools/codegen-output/generate.php",
        "codegen-output:check": "php tools/codegen-output/generate.php --check",
        "license:check": "php tools/check-license-headers.php"
    }
}
