{
    "smithy": "2.0",
    "shapes": {
        "example#Service": {
            "type": "service",
            "version": "2026-09-04",
            "operations": [
                {
                    "target": "example#Call"
                }
            ],
            "traits": {
                "smithy.protocols#rpcv2Cbor": {}
            }
        },
        "example#Call": {
            "type": "operation",
            "input": {
                "target": "example#Message"
            },
            "output": {
                "target": "example#Message"
            }
        },
        "example#Message": {
            "type": "structure",
            "members": {
                "message": {
                    "target": "smithy.api#String"
                }
            }
        }
    }
}
